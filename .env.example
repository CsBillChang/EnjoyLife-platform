# 仅供本地开发。复制为 .env 后按需修改；.env 已被 Git 忽略。
APP_ADDR=127.0.0.1:18080
PPROF_ADDR=127.0.0.1:18081
# 默认关闭持续争用采样；仅诊断轮显式设置。
PPROF_MUTEX_FRACTION=0
PPROF_BLOCK_RATE=0
SHOP_CACHE_MODE=two-level
HTTP_ACCESS_LOG=1
GORM_SILENT=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=huixiang_life
MYSQL_USER=huixiang
MYSQL_PASSWORD=local_dev_only
MYSQL_ROOT_PASSWORD=local_root_only
REDIS_PORT=16379
RABBITMQ_AMQP_PORT=15672
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=huixiang
RABBITMQ_PASSWORD=local_dev_only
WORKER_COUNT=4
RABBITMQ_PREFETCH=4
RATE_LIMIT_TOTAL_CAPACITY=200
RATE_LIMIT_TOTAL_REFILL_PER_SECOND=100
RATE_LIMIT_USER_CAPACITY=5
RATE_LIMIT_USER_REFILL_PER_SECOND=1
