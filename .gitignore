# 本机配置；公开的示例配置保留。
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# 构建、覆盖率、运行日志和本地工具缓存。
/bin/
/dist/
/coverage/
/coverage.out
*.test
*.prof
*.pprof
*.log
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.venv/
node_modules/

# 本机数据库、备份和临时目录；migrations/ 的结构 SQL 仍上传。
*.db
*.sqlite
*.sqlite3
/backups/
/data/
/logs/
/tmp/

# 实验产物默认不上传，只允许已审查的摘要、分析和来源校验文件。
/artifacts/**
!/artifacts/**/
!/artifacts/*/*/README.md
!/artifacts/*/*/summary.json
!/artifacts/*/*/results.json
!/artifacts/*/*/result.json
!/artifacts/*/*/environment.json
!/artifacts/measurements/20260922-delivery/load-config.json
!/artifacts/*/*/config.json
!/artifacts/*/*/profiling-config.json
!/artifacts/*/*/health.json
!/artifacts/*/*/SHA256SUMS
!/artifacts/*/*/checksums.sha256
!/artifacts/*/*/source-*.sha256
!/artifacts/*/*/api-binary.sha256
!/artifacts/*/*/baseline-api.sha256
!/artifacts/*/*/optimized-api.sha256
!/artifacts/*/*/api-go-version-m.txt
!/artifacts/*/*/baseline-api-go-version-m.txt
!/artifacts/*/*/optimized-api-go-version-m.txt
!/artifacts/*/*/go-version.txt
!/artifacts/*/*/benchmark.before.txt
!/artifacts/*/*/benchmark.after.txt
!/artifacts/*/*/sql-invariants-result.txt
!/artifacts/*/*/targeted-test-output.txt
!/artifacts/*/*/stage-a.txt
!/artifacts/measurements/*/analysis/*.txt
